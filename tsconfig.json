{
  "compilerOptions": {
    "types": [
      "node",
      "mocha",
      "chai"
    ],
    "lib": [
      "ES2022"
    ],
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "strict": false
  },
  "include": [
    "tests/**/*.ts",
    "migrations/**/*.ts",
    "target/types/**/*.ts"
  ]
}
